{
  "version": 1,
  "author": "runner-monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-bmp180", "id": "bmp1", "top": -20, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 150, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 200, "left": 150, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 150, "left": 280, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "bmp1:VCC", "esp:3V3", "red", [ "h0" ] ],
    [ "bmp1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "bmp1:SDA", "esp:21", "green", [ "h0" ] ],
    [ "bmp1:SCL", "esp:22", "blue", [ "h0" ] ],
    [ "esp:26", "r1:1", "orange", [ "h0" ] ],
    [ "r1:2", "led1:A", "orange", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "h0" ] ],
    [ "esp:25", "bz1:2", "purple", [ "h0" ] ],
    [ "bz1:1", "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
